# Snapdeal AI Voice KAM — Environment Variables (Optional)
# You can also enter these directly in the web browser UI when the app loads!

# Model (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Get free Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# (Optional) TypeSafe Jev API key from https://typesafe.ai
VITE_JEV_API_KEY=

